# Copy to .env for `npm run dev`. In production these are Fly secrets (fly secrets set ...).
# All optional: without them, feedback is only saved to DATA_DIR/feedback.

# Discord webhook for #semantle-feedback (channel settings > Integrations > Webhooks)
FEEDBACK_WEBHOOK=
# Linear personal API key; issues go to LINEAR_TEAM (default SMI) / LINEAR_PROJECT (default "Semantle Duel")
LINEAR_API_KEY=
# Claude Haiku titles and prioritises each report
ANTHROPIC_API_KEY=

# Dev knobs
# PORT=8080
# AWAY_MS=10000   # auto-pause after 10s of silence instead of 90s
